#!/usr/bin/env bash
# yamllint, ruff, pytest coverage on GitOps helpers.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

CONFIG="$ROOT/.githooks/config"
if [[ -f "$CONFIG" ]]; then
    # shellcheck disable=SC1090
    source "$CONFIG"
fi

"$ROOT/.githooks/check-secrets" staged

if [[ "${SKIP_QUESTSHIFT_HOOKS:-}" == "1" ]]; then
    echo "questshift-gitops pre-commit: lint skipped (SKIP_QUESTSHIFT_HOOKS=1); secret scan already ran"
    exit 0
fi

if ! git diff --cached --name-only --diff-filter=ACMR | grep -Eq '\.(ya?ml|py|toml|sh)$|^k8s/|^install/|^argocd/|^\.githooks/|^verify\.sh$'; then
    exit 0
fi

echo "questshift-gitops pre-commit: yamllint, ruff, coverage"
./verify.sh
