#!/usr/bin/env bash
# Refuse commit/CI of Hugging Face tokens, private keys, GitHub pats, AWS keys,
# kubeconfigs, .env files, or a real questshift.llm.api-key.
# Usage: check-secrets [staged|all]
#   staged — git index (pre-commit). all — tracked files (CI).
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

MODE="${1:-staged}"
if [[ "$MODE" != "staged" && "$MODE" != "all" ]]; then
  echo "usage: check-secrets [staged|all]" >&2
  exit 2
fi

FILES=()
if [[ "$MODE" == "staged" ]]; then
  while IFS= read -r path; do
    [[ -n "$path" ]] && FILES+=("$path")
  done < <(git diff --cached --name-only --diff-filter=ACMR)
else
  while IFS= read -r path; do
    [[ -n "$path" ]] && FILES+=("$path")
  done < <(git ls-files)
fi

if [[ ${#FILES[@]} -eq 0 ]]; then
  exit 0
fi

fail() {
  echo "questshift secret scan: $*" >&2
  echo "Remove the secret, rotate it if it was real, and keep it out of git." >&2
  exit 1
}

blocked_name() {
  local base="$1"
  case "$base" in
    .env | .env.*)
      if [[ "$base" == ".env.example" ]]; then
        return 1
      fi
      return 0
      ;;
    kubeconfig | kubeconfig.* | *.pem | id_rsa | id_ed25519 | application-local.properties | application-secret.properties | secrets.yaml | secret.yaml | *-secret.yaml)
      return 0
      ;;
  esac
  return 1
}

for path in "${FILES[@]}"; do
  base="$(basename "$path")"
  if blocked_name "$base"; then
    fail "refusing to ship secret-looking path ${path}"
  fi
done

CONTENT_RE='-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----|hf_[A-Za-z0-9]{16,}|AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{20,}|gho_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}'

scan_grep() {
  if [[ "$MODE" == "staged" ]]; then
    git grep --cached -E -I -n -e "$1" -- "${FILES[@]}"
  else
    git grep -E -I -n -e "$1" -- "${FILES[@]}"
  fi
}

set +e
hits="$(scan_grep "$CONTENT_RE" 2>/dev/null)"
grep_status=$?
set -e
if [[ "$grep_status" -eq 0 ]]; then
  printf '%s\n' "$hits" >&2
  fail "secret-looking token or PEM in the tree"
fi
if [[ "$grep_status" -gt 1 ]]; then
  fail "git grep failed (status ${grep_status})"
fi

set +e
api_hits="$(scan_grep 'questshift\.llm\.api-key[[:space:]]*=' 2>/dev/null)"
api_status=$?
set -e
if [[ "$api_status" -eq 0 ]]; then
  bad="$(printf '%s\n' "$api_hits" | grep -Ev 'questshift\.llm\.api-key[[:space:]]*=[[:space:]]*none([^A-Za-z0-9_-]|$)' || true)"
  if [[ -n "$bad" ]]; then
    printf '%s\n' "$bad" >&2
    fail "questshift.llm.api-key must stay none in git"
  fi
fi
if [[ "$api_status" -gt 1 ]]; then
  fail "git grep failed (status ${api_status})"
fi

echo "questshift secret scan: ok (${MODE})"
